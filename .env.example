# =============================================================================
# Tweeby Environment Configuration (Template)
# Copy this file to .env: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server & Network Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# The Movie Database (TMDB) API Credentials
# Sign up and generate credentials at: https://www.themoviedb.org/settings/api
# -----------------------------------------------------------------------------
# TMDB API Read Access Token (v4 auth - Recommended Bearer token)
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# TMDB API Key (v3 auth - Fallback query parameter)
TMDB_API_KEY=your_tmdb_api_key_here

# TMDB Endpoints (Optional overrides)
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# -----------------------------------------------------------------------------
# BitTorrent & Storage Configuration (Optional overrides)
# -----------------------------------------------------------------------------
# Maximum concurrent peer connections (default: 200)
MAX_CONNS=200

# Custom storage directory paths (defaults to public/downloads and public/archives)
# DOWNLOAD_DIR=./public/downloads
# ARCHIVE_DIR=./public/archives

# Custom torrent tracker URLs (comma-separated list)
# TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://open.tracker.cl:1337/announce

# -----------------------------------------------------------------------------
# Peer Optimizer Tuning (Optional)
# -----------------------------------------------------------------------------
# PEER_SAMPLE_MS=1000
# PEER_GRACE_MS=8000
# PEER_MIN_RATIO=0.05
# PEER_MIN_PEERS_TO_PRUNE=3
